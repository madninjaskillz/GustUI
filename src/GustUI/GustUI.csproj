<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Cyotek.Drawing.BitmapFont" Version="2.0.4" />
    <PackageReference Include="nkast.Xna.Framework.Blazor" Version="3.14.9001" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <PackageReference Include="StbTrueTypeSharp" Version="1.26.12" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="GustUI.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The default theme's fonts and nine-grid images, as manifest resources
         read by UUContent. They were base64 string literals until 2026-10-08,
         which kept ~13 MB of UTF-16 text resident for the life of the process;
         a resource is read straight out of the mapped assembly when a font is
         baked and costs nothing afterwards. Licences: THIRD-PARTY/. -->
    <EmbeddedResource Include="_Embedded\Content\*" LogicalName="GustUI.Embedded.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>